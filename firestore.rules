rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authorization comes ONLY from custom claims set by scripts/promote-admin.ts.
    // Never from a Firestore field the client can write, and never from an email pattern.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.role in ['super_admin', 'admin', 'staff'];
    }
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == 'super_admin';
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Public catalogue, admin-managed
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update: if isAdmin()
          || (isOwner(resource.data.userId)
              && request.resource.data.status == resource.data.status);
        allow delete: if isAdmin() || isOwner(resource.data.userId);
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users may manage their own profile but NEVER their own privileges.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['role', 'permissions', 'status']);
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(['role', 'permissions', 'status']) == false);
      allow delete: if isAdmin();

      match /cart/{cartId}      { allow read, write: if isOwner(userId) || isAdmin(); }
      match /wishlist/{itemId}  { allow read, write: if isOwner(userId) || isAdmin(); }
      match /addresses/{addrId} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    // Orders are written exclusively by the server via the Admin SDK,
    // which bypasses these rules. Clients may only read their own.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Written by the server only. Not writable by clients at all.
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}
